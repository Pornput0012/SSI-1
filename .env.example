# Optional local overrides for docker-compose.yml. Copy this file to .env.
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Keep the database name aligned with db/init.sql.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=ssi
MYSQL_PASSWORD=ssi-local-password

# Public URL used in email links and as the JWT issuer.
APP_HOST_URL=http://localhost:5173
JWT_ISSUER=http://localhost:5173

# For email verification and password reset, provide a reachable SMTP server.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false

# Replace these development-only values in shared or production environments.
JWT_SECRET_VERIFY_EMAIL=dev-only-verify-email-secret-change-me
JWT_SECRET_RESET_PASSWORD=dev-only-reset-password-secret-change-me
JWT_SECRET_ACCESS=dev-only-access-token-secret-change-me
JWT_SECRET_REFRESH=dev-only-refresh-token-secret-change-me

# Defaults to the same-origin Nginx proxy path.
VITE_URL_API=/ssi1
